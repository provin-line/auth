{
	"name": "@provin-line/auth-provider-dplaax-module",
	"description": "dPLaaX composition layer for @o3co/auth-provider-* (module wiring, DID resolver, config schema)",
	"version": "0.1.0",
	"license": "Apache-2.0",
	"type": "module",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"types": "./dist/index.d.mts"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/provin-line/auth.git",
		"directory": "packages/provider-dplaax-module"
	},
	"scripts": {
		"prebuild": "rimraf dist",
		"build": "tsc",
		"prepare": "pnpm run build",
