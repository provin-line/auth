{
	"name": "@provin-line/create-auth-provider",
	"description": "Scaffold generator for dPLaaX auth.provider deployment instances",
	"version": "0.1.0",
	"license": "Apache-2.0",
	"type": "module",
	"bin": {
		"create-auth-provider": "./dist/cli.mjs"
	},
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"types": "./dist/index.d.mts"
		}
	},
	"files": [
		"dist",
		"src/template",
		"README.md",
		"LICENSE"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/provin-line/auth.git",
		"directory": "packages/create-auth-provider"
	},
	"scripts": {
		"prebuild": "rimraf dist",
		"build": "tsc && node ./scripts/copy-template.mjs",
		"prepare": "pnpm run build",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {},
	"devDependencies": {
		"@provin-line/auth-provider-did": "workspace:*",
		"@types/node": "^25.6.0",
		"@vitest/coverage-v8": "^4.1.4",
		"rimraf": "^6.1.3",
		"typescript": "^5.9.3",
		"vitest": "^4.1.4"
	}
}
