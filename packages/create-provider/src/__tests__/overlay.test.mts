// Each transformation of the overlay is a pure function over one generated
// file; the fixtures are cut from what the upstream generator writes for an
// app composing the provin modules as packages outside its release, so an
// upstream change that moves an anchor fails here before it fails a build.

import { readFileSync } from "node:fs";
import { join } from "node:path";
import { describe, expect, it } from "vitest";
import {
	patchApplicationConf,
	patchEnvExample,
	patchLocalConfExample,
} from "../overlay/config.mjs";
import { applyProvinModules, type OverlayOptions } from "../overlay/index.mjs";
import { patchPackageJson } from "../overlay/package-json.mjs";
import { patchReadme } from "../overlay/readme.mjs";
import { patchWorkspaceYaml } from "../overlay/workspace-yaml.mjs";

/** This generator's own version, which it composes every provin package at. */
const release = (JSON.parse(readFileSync(join(import.meta.dirname, "..", "..", "package.json"), "utf8")) as { version: string })
	.version;

const options: OverlayOptions = {
	name: "@acme/login",
	description: "Acme login",
	license: "Apache-2.0",
	author: "Acme",
	registryBaseUrl: "http://registry.internal:8443",
};

const UPSTREAM_PACKAGE_JSON = `{
	"name": "auth-provider-app",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.28.7",
	"dependencies": {
		"@o3co/auth-provider-foundation": "0.19.0",
		"@provin-line/auth-did-grant": "${release}",
		"@provin-line/auth-did-grant-store": "${release}",
		"@provin-line/auth-dplaax-registry": "${release}",
		"zod": "4.6.7"
	}
}
`;

const UPSTREAM_CONF = `# Each key reads its environment variable (see .env.example); this file holds no values.
did-grant {
	message-max-age = \${?DID_GRANT_MESSAGE_MAX_AGE}
	revocation-latency-bound = \${?DID_GRANT_REVOCATION_LATENCY_BOUND}
}
dplaax-registry {
	url = \${?DPLAAX_REGISTRY_URL}
}
tokens {
	revocation = \${?TOKENS_REVOCATION}
}
keys {
	signing {
		kid = \${?KEYS_SIGNING_KID}
		alg = \${?KEYS_SIGNING_ALG}
		private-key = \${?KEYS_SIGNING_PRIVATE_KEY}
	}
}
`;

const UPSTREAM_ENV = `## Copy to .env, uncomment each line you set and replace its placeholder.
# KERNEL_DEPLOYMENT=single
# DID_GRANT_REVOCATION_LATENCY_BOUND=15m
# DPLAAX_REGISTRY_URL=https://registry.example.invalid
# KEYS_SIGNING_ALG=RS256
`;

const UPSTREAM_LOCAL = `## Copy to config/local.conf, uncomment each key.
# outbound.allow = [
# 	"destination.example.invalid"
# ]
# audit.receivers = [REPLACE-RECEIVER-NAMES]
# clients.registered = [
# 	{
# 		"id": "example-client",
# 		"kind": "public",
# 		"method": "none"
# 	}
# ]
# keys.signing.private-key = """-----BEGIN PRIVATE KEY-----
# REPLACE-PKCS8-PEM-PRIVATE-KEY
# -----END PRIVATE KEY-----"""
`;

const UPSTREAM_WORKSPACE = `overrides:
  "@o3co/auth-provider-foundation": 0.19.0
  zod: 4.6.7
minimumReleaseAge: 1440
minimumReleaseAgeExclude:
  - "@o3co/auth-provider-foundation"
  - "@provin-line/auth-did-grant-store@${release}"
  - "@provin-line/auth-did-grant@${release}"
  - "@provin-line/auth-dplaax-registry@${release}"
`;

const UPSTREAM_README = `# Auth provider

Generated by \`create-auth-provider\` from the modules listed.

## Changing the modules

Generate again with the list changed. \`create-auth-provider <target> --pattern <pattern>\` and \`--add\`.

Boot names what a change needs.

## Packages outside this release

kept
`;

describe("patchPackageJson", () => {
	const out = JSON.parse(patchPackageJson(UPSTREAM_PACKAGE_JSON, options));

	it("takes name, description, license and author from the options", () => {
		expect(out.name).toBe("@acme/login");
		expect(out.description).toBe("Acme login");
		expect(out.license).toBe("Apache-2.0");
		expect(out.author).toBe("Acme");
	});

	it("leaves out author when none is given", () => {
		const bare = JSON.parse(patchPackageJson(UPSTREAM_PACKAGE_JSON, { ...options, author: "" }));
		expect(bare).not.toHaveProperty("author");
	});

	it("keeps the dependencies upstream wrote, the provin modules among them, and adds none", () => {
		expect(out.dependencies).toEqual(JSON.parse(UPSTREAM_PACKAGE_JSON).dependencies);
		expect(out.packageManager).toBe("pnpm@11.28.7");
	});

	it("escapes free-form values", () => {
		const quoted = JSON.parse(patchPackageJson(UPSTREAM_PACKAGE_JSON, { ...options, description: 'say "hi"\n' }));
		expect(quoted.description).toBe('say "hi"\n');
	});

	it("refuses a manifest whose dependencies lack a provin module, which upstream did not compose", () => {
		const without = UPSTREAM_PACKAGE_JSON.replace(`\t\t"@provin-line/auth-did-grant-store": "${release}",\n`, "");
		expect(() => patchPackageJson(without, options)).toThrow(/auth-did-grant-store/);
	});
});

describe("patchApplicationConf", () => {
	const out = patchApplicationConf(UPSTREAM_CONF);

	it("binds the four keys no module's example holds, each to its variable", () => {
		for (const line of [
			"keys.signing.secret = ${?KEYS_SIGNING_SECRET}",
			"keys.signing.secret-encoding = ${?KEYS_SIGNING_SECRET_ENCODING}",
			"tokens.subject-check = ${?TOKENS_SUBJECT_CHECK}",
			"tokens.access-token-lifetime = ${?TOKENS_ACCESS_TOKEN_LIFETIME}",
		]) {
			expect(out.split("\n")).toContain(line);
		}
	});

	it("keeps upstream's bindings, the provin sections' among them, as written", () => {
		expect(out.startsWith(UPSTREAM_CONF)).toBe(true);
	});

	it("holds no value of its own: every assignment is an optional substitution", () => {
		for (const line of out.split("\n").filter((l) => l.includes("="))) {
			expect(line).toMatch(/= \$\{\?[A-Z0-9_]+\}$/);
		}
	});
});

describe("patchEnvExample", () => {
	const out = patchEnvExample(UPSTREAM_ENV, options);

	it("lists the variables of the four keys it binds", () => {
		expect(out).toMatch(/^# TOKENS_SUBJECT_CHECK=none$/m);
		expect(out).toMatch(/^# TOKENS_ACCESS_TOKEN_LIFETIME=10m$/m);
		expect(out).toMatch(/^# KEYS_SIGNING_SECRET=REPLACE-/m);
		expect(out).toMatch(/^# KEYS_SIGNING_SECRET_ENCODING=utf8$/m);
	});

	it("says what boot holds the lifetime to", () => {
		expect(out).toMatch(/TOKENS_ACCESS_TOKEN_LIFETIME at most DID_GRANT_REVOCATION_LATENCY_BOUND/);
	});

	it("defaults the registry URL to the option, in upstream's line", () => {
		expect(out).toMatch(/^# DPLAAX_REGISTRY_URL=http:\/\/registry\.internal:8443$/m);
		expect(out).not.toContain("registry.example.invalid");
	});

	it("keeps upstream's other lines, and writes no provin section variable twice", () => {
		expect(out).toContain("# KERNEL_DEPLOYMENT=single");
		expect(out.match(/DID_GRANT_REVOCATION_LATENCY_BOUND=/g)).toHaveLength(1);
	});

	it("refuses an example without the registry's line", () => {
		expect(() => patchEnvExample("# KERNEL_DEPLOYMENT=single\n", options)).toThrow(/DPLAAX_REGISTRY_URL/);
	});
});

describe("patchLocalConfExample", () => {
	const out = patchLocalConfExample(UPSTREAM_LOCAL, options);

	it("allows the registry's host", () => {
		expect(out).toContain('# \t"registry.internal"');
		expect(out).not.toContain("destination.example.invalid");
	});

	it("names the registry's host and port for plain http inside the network", () => {
		expect(out).toContain("# outbound.plain-internal = [");
		expect(out).toContain('# \t"registry.internal:8443"');
	});

	it("allows the DID grant type in the example client", () => {
		expect(out).toContain('"grants": ["https://dplaax.dev/oauth/grant-type/did"]');
	});

	it("names no plain-internal pair for an https registry, which needs no plain http", () => {
		const https = patchLocalConfExample(UPSTREAM_LOCAL, { ...options, registryBaseUrl: "https://registry.example.com" });
		expect(https).not.toContain("plain-internal");
		expect(https).toContain("# outbound.internal-hosts = [");
	});

	it("uses port 80 for an http registry URL that names none", () => {
		const bare = patchLocalConfExample(UPSTREAM_LOCAL, { ...options, registryBaseUrl: "http://registry.internal" });
		expect(bare).toContain('# \t"registry.internal:80"');
	});

	it("refuses an example without outbound.allow", () => {
		expect(() => patchLocalConfExample("# nothing\n", options)).toThrow(/outbound\.allow/);
	});
});

describe("patchWorkspaceYaml", () => {
	const out = patchWorkspaceYaml(UPSTREAM_WORKSPACE);

	it("lets did-dplaax at its exact version install within its first day, as upstream lets the modules", () => {
		expect(out.split("\n")).toContain(`  - "@provin-line/did-dplaax@${release}"`);
	});

	it("adds it inside minimumReleaseAgeExclude, keeping upstream's entries", () => {
		const list = out.slice(out.indexOf("minimumReleaseAgeExclude:"));
		expect(list).toContain(
			`  - "@provin-line/auth-dplaax-registry@${release}"\n  - "@provin-line/did-dplaax@${release}"\n`,
		);
		expect(out.startsWith("overrides:\n")).toBe(true);
	});

	it("adds it once, though upstream names it", () => {
		expect(patchWorkspaceYaml(out)).toBe(out);
	});

	it("refuses a list it would not keep valid YAML, such as one indented otherwise", () => {
		const fourSpaces = UPSTREAM_WORKSPACE.replaceAll("\n  - ", "\n    - ");
		expect(() => patchWorkspaceYaml(fourSpaces)).toThrow(/minimumReleaseAgeExclude/);
		expect(() => patchWorkspaceYaml("minimumReleaseAgeExclude: []\n")).toThrow(/minimumReleaseAgeExclude/);
	});

	it("refuses a file without minimumReleaseAgeExclude", () => {
		expect(() => patchWorkspaceYaml("overrides:\n  zod: 4.6.7\n")).toThrow(/minimumReleaseAgeExclude/);
	});
});

describe("patchReadme", () => {
	const out = patchReadme(UPSTREAM_README, options);

	it("names the project and its description", () => {
		expect(out.startsWith("# @acme/login\n\nAcme login\n")).toBe(true);
	});

	it("names the settings the modules need", () => {
		for (const key of [
			"did-grant.revocation-latency-bound",
			"tokens.access-token-lifetime",
			"TOKENS_ACCESS_TOKEN_LIFETIME",
			"dplaax-registry.url",
			"keys.signing.secret-encoding",
			"clients.registered",
			"outbound.plain-internal",
			"tokens.subject-check",
			"TOKENS_SUBJECT_CHECK",
			"/oauth/introspect",
			"message-max-age",
		]) {
			expect(out).toContain(key);
		}
	});

	it("says how to install a did-dplaax version published within the last day", () => {
		expect(out).toContain("@provin-line/did-dplaax");
		expect(out).toContain("minimumReleaseAgeExclude");
	});

	it("says nothing of git refs, which the app no longer has", () => {
		expect(out).not.toMatch(/git-subdirectory|blockExoticSubdeps|allowBuilds/);
	});

	it("replaces upstream's Changing-the-modules section, whose commands are not this generator's", () => {
		expect(out).not.toContain("<target>");
		expect(out).toContain("## Changing the modules");
		expect(out).toContain("@provin-line/create-auth-provider");
		expect(out).toContain("## Packages outside this release\n\nkept");
	});

	it("refuses a README without a title", () => {
		expect(() => patchReadme("no title\n", options)).toThrow(/README/);
	});
});

describe("applyProvinModules", () => {
	const files = new Map<string, string>([
		["package.json", UPSTREAM_PACKAGE_JSON],
		["config/application.conf", UPSTREAM_CONF],
		[".env.example", UPSTREAM_ENV],
		["config/local.conf.example", UPSTREAM_LOCAL],
		["README.md", UPSTREAM_README],
		["pnpm-workspace.yaml", UPSTREAM_WORKSPACE],
		["src/main.ts", "assemble({ modules: [m0], config });\n"],
		["AGENTS.md", "| `@provin-line/auth-did-grant` |\n"],
	]);
	const out = applyProvinModules(files, options);

	it("patches the files it owns", () => {
		expect(out.get("pnpm-workspace.yaml")).toBe(patchWorkspaceYaml(UPSTREAM_WORKSPACE));
		expect(out.get("config/application.conf")).toBe(patchApplicationConf(UPSTREAM_CONF));
	});

	it("leaves the entry point and the agents' index as upstream wrote them, which compose and index the modules", () => {
		expect(out.get("src/main.ts")).toBe(files.get("src/main.ts"));
		expect(out.get("AGENTS.md")).toBe(files.get("AGENTS.md"));
	});

	it("does not touch its input", () => {
		expect(files.get("package.json")).toBe(UPSTREAM_PACKAGE_JSON);
	});

	it("names the file it could not find when upstream drops one", () => {
		const missing = new Map(files);
		missing.delete("pnpm-workspace.yaml");
		expect(() => applyProvinModules(missing, options)).toThrow(/pnpm-workspace\.yaml/);
	});
});
