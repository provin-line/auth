{
	"name": "@provin-line/create-auth-provider",
	"description": "Scaffold generator for dPLaaX auth.provider deployment instances",
	"version": "0.4.0",
	"license": "Apache-2.0",
	"type": "module",
	"bin": {
		"create-auth-provider": "./dist/cli.mjs"
	},
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"types": "./dist/index.d.mts"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/provin-line/auth.git",
		"directory": "packages/create-provider"
	},
	"scripts": {
		"prebuild": "rimraf dist",
		"build": "tsc",
		"prepare": "pnpm run build",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@o3co/auth-provider-scaffold": "0.18.4"
	},
	"devDependencies": {
		"@types/node": "^26.6.5",
		"@vitest/coverage-v8": "^5.0.5",
		"rimraf": "^6.1.3",
		"typescript": "^6.0.3",
		"vitest": "^5.0.5"
	}
}
