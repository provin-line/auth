{
	"name": "@provin-line/auth-did-grant",
	"description": "The dPLaaX DID grant as an auth.provider 0.18 module",
	"version": "0.1.0",
	"license": "Apache-2.0",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/contract.d.mts",
			"default": "./dist/contract.mjs"
		},
		"./module": {
			"types": "./dist/module.d.mts",
			"default": "./dist/module.mjs"
		},
		"./testing": {
			"types": "./dist/testing.d.mts",
			"default": "./dist/testing.mjs"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"config.example",
		"reference.conf"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/provin-line/auth.git",
		"directory": "packages/did-grant"
	},
	"scripts": {
		"prebuild": "rimraf dist",
		"build": "tsc",
		"prepare": "pnpm run build",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {
		"jose": "^6.2.13"
	},
	"peerDependencies": {
		"@noble/ed25519": "^3.2.0",
		"@o3co/auth-provider-foundation": "0.18.4",
		"@o3co/auth-provider-identity": "0.18.4",
		"@o3co/auth-provider-oauth": "0.18.4",
		"zod": "^4.6.7"
	},
	"peerDependenciesMeta": {
		"@noble/ed25519": {
			"optional": true
		}
	},
	"devDependencies": {
		"@noble/ed25519": "^3.2.0",
		"@o3co/auth-provider-foundation": "0.18.4",
		"@o3co/auth-provider-identity": "0.18.4",
		"@o3co/auth-provider-oauth": "0.18.4",
		"@types/node": "^26.6.5",
		"@vitest/coverage-v8": "^5.0.5",
		"rimraf": "^6.1.3",
		"typescript": "^6.0.3",
		"vitest": "^5.0.5",
		"zod": "^4.6.7"
	}
}
